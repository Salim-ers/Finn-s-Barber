# Copier en .env.local pour tester avec une vraie base (sinon base embarquée dans .data/)
# DATABASE_URL=postgres://...

# Tableau de bord /admin (en local, mot de passe par défaut : finns)
ADMIN_PASSWORD=
SESSION_SECRET=

# E-mails de confirmation — Gmail (mot de passe d’application) ou toute boîte SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SALON_NOTIFY_EMAIL=
# … ou Resend (nom de domaine vérifié)
RESEND_API_KEY=
# Rappel la veille (tâche planifiée de vercel.json) : signature des appels de Vercel
CRON_SECRET=

# Domaine définitif (sitemap, liens des e-mails)
NEXT_PUBLIC_SITE_URL=
